# Copy this file to .env and fill in real values
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password
# Leave blank locally. In production (Render), set this to your exact
# Vercel frontend URL, e.g. https://your-store.vercel.app
CORS_ORIGIN=

# Cloudinary — permanent image hosting (free tier). Get these from
# https://cloudinary.com/console after signing up (free).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — sends order confirmation emails. Get an API key free at
# https://resend.com/api-keys . Leave FROM_EMAIL as-is to start;
# see README for using your own domain later.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
STORE_NAME=Gallery & Co.

# Razorpay — real online payments. Get TEST keys free at
# https://dashboard.razorpay.com/app/keys (toggle "Test Mode" on first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
